<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_equipment_rental" model="ir.module.category">
        <field name="name">Equipment Rental</field>
        <field name="description">Security groups for equipment rental operations.</field>
        <field name="sequence">35</field>
    </record>

    <record id="res_groups_privilege_equipment_rental" model="res.groups.privilege">
        <field name="name">Equipment Rental</field>
        <field name="sequence">35</field>
        <field name="category_id" ref="x_equipment_rental.module_category_equipment_rental"/>
    </record>

    <record id="group_rental_user" model="res.groups">
        <field name="name">Rental User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="x_equipment_rental.res_groups_privilege_equipment_rental"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_rental_manager" model="res.groups">
        <field name="name">Rental Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="x_equipment_rental.res_groups_privilege_equipment_rental"/>
        <field name="implied_ids" eval="[(4, ref('x_equipment_rental.group_rental_user'))]"/>
    </record>
</odoo>
