<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rental_availability_wizard_form" model="ir.ui.view">
        <field name="name">x.rental.availability.wizard.form</field>
        <field name="model">x.rental.availability.wizard</field>
        <field name="arch" type="xml">
            <form string="Equipment Availability">
                <group>
                    <group>
                        <field name="start_date"/>
                        <field name="end_date"/>
                    </group>
                    <group>
                        <field name="category_id"/>
                        <field name="available_equipment_count" readonly="1"/>
                    </group>
                </group>
                <footer>
                    <button name="action_show_available_equipment" string="Show Available Equipment" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_rental_availability_wizard" model="ir.actions.act_window">
        <field name="name">Equipment Availability</field>
        <field name="res_model">x.rental.availability.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
