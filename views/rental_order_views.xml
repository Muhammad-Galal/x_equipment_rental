<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rental_order_list" model="ir.ui.view">
        <field name="name">x.rental.order.list</field>
        <field name="model">x.rental.order</field>
        <field name="arch" type="xml">
            <list string="Rental Orders" sample="1">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="rental_start_date"/>
                <field name="rental_end_date"/>
                <field name="duration_days"/>
                <field name="equipment_count"/>
                <field name="amount_total"/>
                <field name="user_id"/>
                <field name="state"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_rental_order_form" model="ir.ui.view">
        <field name="name">x.rental.order.form</field>
        <field name="model">x.rental.order</field>
        <field name="arch" type="xml">
            <form string="Rental Order">
                <sheet>
                    <widget name="web_ribbon" title="Cancelled" bg_color="text-bg-danger" invisible="state != 'cancelled'"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="user_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="rental_start_date"/>
                            <field name="rental_end_date"/>
                            <field name="duration_days" readonly="1"/>
                            <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,out,returned,invoiced,cancelled"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Equipment">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="equipment_id"/>
                                    <field name="category_id" optional="show"/>
                                    <field name="daily_rate"/>
                                    <field name="weekly_rate"/>
                                    <field name="duration_days" readonly="1"/>
                                    <field name="pricing_type" readonly="1"/>
                                    <field name="price_subtotal" readonly="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="note"/>
                        </page>
                        <page string="Generated Documents">
                            <group>
                                <field name="sale_order_id" readonly="1"/>
                                <field name="account_move_id" readonly="1"/>
                                <field name="amount_total" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_rental_order_search" model="ir.ui.view">
        <field name="name">x.rental.order.search</field>
        <field name="model">x.rental.order</field>
        <field name="arch" type="xml">
            <search string="Rental Orders">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="user_id"/>
                <field name="company_id"/>
                <filter name="my_rentals" string="My Rentals" domain="[('user_id', '=', uid)]"/>
                <separator/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="confirmed" string="Confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter name="out" string="Out" domain="[('state', '=', 'out')]"/>
                <filter name="returned" string="Returned" domain="[('state', '=', 'returned')]"/>
                <filter name="invoiced" string="Invoiced" domain="[('state', '=', 'invoiced')]"/>
                <filter name="cancelled" string="Cancelled" domain="[('state', '=', 'cancelled')]"/>
                <group>
                    <filter name="group_by_partner" string="Customer" domain="[]" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_by_responsible" string="Responsible" domain="[]" context="{'group_by': 'user_id'}"/>
                    <filter name="group_by_state" string="State" domain="[]" context="{'group_by': 'state'}"/>
                    <filter name="group_by_company" string="Company" domain="[]" context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_rental_order" model="ir.actions.act_window">
        <field name="name">Rental Orders</field>
        <field name="res_model">x.rental.order</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_rental_order_search"/>
        <field name="context">{'default_user_id': uid}</field>
    </record>
</odoo>
