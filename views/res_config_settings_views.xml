<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.x.equipment.rental</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale_management.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <app name="sale_management" position="inside">
                <block title="Equipment Rental" id="equipment_rental_settings">
                    <setting id="rental_sale_integration_mode_setting" help="Choose which commercial document is generated when a rental order is confirmed.">
                        <field name="rental_sale_integration_mode"/>
                    </setting>
                    <setting id="rental_service_product_setting" help="Product used on generated sales orders and customer invoices for rental charges.">
                        <field name="rental_service_product_id"/>
                    </setting>
                    <setting id="rental_late_fee_setting" help="Fixed late fee charged per overdue day and per rented equipment line.">
                        <field name="rental_late_fee_per_day"/>
                    </setting>
                </block>
            </app>
        </field>
    </record>
</odoo>
